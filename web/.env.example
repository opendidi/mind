# ============================================
# Mind Editor - Web 环境变量配置
# 复制此文件为 .env.development 或 .env.production
# ============================================

# 后台接口地址
VITE_GLOB_API_URL=http://127.0.0.1:5001/v1

# 发布路径（子路径部署时修改，如 /mind/）
VITE_APP_BASE_URL=/

# 网站标题
VITE_GLOB_APP_TITLE=图形可视化编辑器

# 网站短名称（PWA 用）
VITE_GLOB_APP_SHORT_NAME=Mind

# -------------------- 开发环境 --------------------
# 开发服务器端口
VITE_PORT=3100

# 代理配置（JSON 格式）
# VITE_PROXY=[["/v1/","http://127.0.0.1:5001"]]

# -------------------- 构建相关 --------------------
# 是否启用 PWA
VITE_USE_PWA=false

# 是否启用 Mock
VITE_USE_MOCK=false

# 是否启用图片压缩
VITE_USE_IMAGEMIN=false

# 是否启用旧版浏览器支持
VITE_LEGACY=false

# 构建压缩方式: none / gzip / brotli / gzip,brotli
VITE_BUILD_COMPRESS=none

# 压缩后是否删除原文件
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE=false

# 高德地图 JSAPI Key（在 https://console.amap.com 申请，需配置域名白名单）
VITE_AMAP_KEY=your-amap-jsapi-key