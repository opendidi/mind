# ==========================================================================
# mind — 图形可视化编辑器 环境配置
# ==========================================================================
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# ==========================================================================


# ══════════════════════════════════════════════════════════════════════════════
# MySQL 数据库
# ══════════════════════════════════════════════════════════════════════════════
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change-me-to-a-strong-password
DB_PORT=3306
DB_NAME=mind


# ══════════════════════════════════════════════════════════════════════════════
# Redis（Agent 系统缓存 / 会话状态 / 工具结果缓存 / PlanFeedback 闭环）
# ══════════════════════════════════════════════════════════════════════════════
# 注意：Agent 系统依赖 Redis 实现以下功能：
#   - DB 0: 默认
#   - DB 5: 工具结果缓存 + PlanMemory 评分记忆
#   - DB 6: LLM 熔断器状态
# 如果 Redis 不可用，部分模块自动降级为内存实现。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=


# ══════════════════════════════════════════════════════════════════════════════
# MinIO 对象存储（素材/文件上传）
# ══════════════════════════════════════════════════════════════════════════════
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_CDN_URL=127.0.0.1:9000
MINIO_BUCKET_NAME=mind
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_SECURE=false


# ══════════════════════════════════════════════════════════════════════════════
# LLM 配置（Agent 系统核心依赖）
# ══════════════════════════════════════════════════════════════════════════════

# 主 LLM — DeepSeek（必填）
# 至少配置一个 LLM，否则 Agent 无法启动
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# LLM 调用统一超时（秒），默认 120
LLM_TIMEOUT=120

# ── Fallback LLM 第一级（可选）─────────────────────────────────────────────
# 主 LLM 不可用时自动切换。API 需兼容 OpenAI 接口格式。
# FALLBACK1_API_KEY=sk-your-fallback1-key
# FALLBACK1_BASE_URL=https://api.openai.com/v1
# FALLBACK1_MODEL=gpt-4o-mini

# ── Fallback LLM 第二级（可选）─────────────────────────────────────────────
# FALLBACK2_API_KEY=sk-your-fallback2-key
# FALLBACK2_BASE_URL=
# FALLBACK2_MODEL=

# ── Vision API（图片分析，可选）─────────────────────────────────────────────
# 用于 Agent 分析图片内容。不配置则图片分析功能不可用。
# VISION_API_KEY=sk-your-vision-key
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_MODEL=gpt-4o

# ── Exa Search API（AI 语义搜索，可选）──────────────────────────────────────
# Exa 使用 AI 语义理解进行网页搜索，结果比传统关键词搜索更精准。
# 注册地址: https://exa.ai
# 不配置则 Agent 自动使用 DuckDuckGo（免费）搜索。
# EXA_API_KEY=your-exa-api-key


# ══════════════════════════════════════════════════════════════════════════════
# 安全配置
# ══════════════════════════════════════════════════════════════════════════════
# Flask SECRET_KEY（生产环境务必设置为随机字符串）
SECRET_KEY=change-me-to-a-random-string

# CORS 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100

# ══════════════════════════════════════════════════════════════════════════════
# 前端站点地址（用于生成预览链接等）
# ══════════════════════════════════════════════════════════════════════════════
APP_URL=http://localhost:3100

# --- 高德地图 Web API Key (用于地理编码、路线规划等后端服务) ---
AMAP_KEY=your-amap-web-api-key